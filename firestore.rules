rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny all unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security and authentication
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'admin@mashallahbroker.com' ||
        request.auth.token.email.lower() == 'mkedit654@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Products Collection: Publicly visible, manageable from site admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // 2. Site Settings: Publicly visible, manageable from site admin
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }

    // 3. FAQs: Publicly visible, manageable from site admin
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isValidId(faqId);
    }

    // 4. Testimonials: Publicly visible, manageable from site admin
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isValidId(testimonialId);
    }

    // 5. Leads (Inquiries):
    // - Customers can CREATE an inquiry (with input size limits to prevent spam)
    // - ONLY authenticated Admin can READ, UPDATE, or DELETE leads
    // - Client PII (phone, email, inquiries) is strictly protected
    match /leads/{leadId} {
      allow create: if isValidId(leadId) &&
        incoming().fullName is string && incoming().fullName.size() > 0 && incoming().fullName.size() <= 100 &&
        incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() > 0 && incoming().phone.size() <= 50 &&
        incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // 6. User Accounts:
    // - Users can only read their own profile, admin can read all
    // - Self-privilege escalation is forbidden
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in incoming()) || incoming().role != 'admin' || isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isAdmin();
    }

    // 7. Connection verification
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
